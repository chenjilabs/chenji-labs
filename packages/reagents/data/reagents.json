{
  "dataset": "reagents",
  "version": 1,
  "description": "The chemical store: the reagents the first practicals need, with formula, appearance, acid-base data, indicator colours and hazard pictograms.",
  "conventions": {
    "formula": "Plain-text formula of the substance as it is used, parsed by chem-core. Molar mass and the display form (with subscripts) are computed from it, never stored. null only for mixtures.",
    "appearance": "Always written in words, so no result depends on colour alone. displayColour is an approximate sRGB colour for drawing, or null for colourless and transparent.",
    "acidBase": "pKa values belong to the acid form (the conjugate acid for a base), at 25 °C, in order of dissociation. null marks a step that is complete in water (a strong acid). Strong bases list no pKa.",
    "indicator": "scale lists the colour at increasing pH. Between two points the colour changes gradually; below the first or above the last point it stays the same.",
    "hazards": "GHS pictograms for the form named in appliesTo, usually the substance as supplied. Dilute lab solutions often carry fewer pictograms or none. This is teaching data, not a safety data sheet: in a real lab, follow the supplier's SDS.",
    "review": "Every entry starts as \"needs-review\". A chemistry reviewer changes it to \"reviewed\" after checking it against the sources."
  },
  "ghs": {
    "GHS01": { "name": "Exploding bomb", "meaning": "Explosive" },
    "GHS02": { "name": "Flame", "meaning": "Flammable" },
    "GHS03": { "name": "Flame over circle", "meaning": "Oxidising" },
    "GHS04": { "name": "Gas cylinder", "meaning": "Gas under pressure" },
    "GHS05": { "name": "Corrosion", "meaning": "Corrosive to skin, eyes or metals" },
    "GHS06": { "name": "Skull and crossbones", "meaning": "Acutely toxic" },
    "GHS07": { "name": "Exclamation mark", "meaning": "Harmful or irritant" },
    "GHS08": { "name": "Health hazard", "meaning": "Serious longer-term health hazard" },
    "GHS09": { "name": "Environment", "meaning": "Toxic to aquatic life" }
  },
